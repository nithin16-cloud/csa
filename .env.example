# ==============================================================================
# CloudSky Airways — Environment Configuration Template
# Duplicate this file as .env and fill in your values
# ==============================================================================

# Application Environment (production | development | testing)
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000

# Security (Generate a secure random string: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-this-to-a-cryptographically-secure-random-key-in-production

# Database Engine Configuration (sqlite | mongodb)
DB_TYPE=sqlite

# SQLite Configuration (used when DB_TYPE=sqlite)
DATABASE_PATH=cloudsky.db

# MongoDB Configuration (used when DB_TYPE=mongodb or when MONGO_URI is specified)
# Local: mongodb://localhost:27017/cloudsky
# Cloud Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/cloudsky?retryWrites=true&w=majority
MONGO_URI=
MONGO_DB_NAME=cloudsky

# Cookie Security (set to 1 when serving over HTTPS in production)
SESSION_COOKIE_SECURE=0
